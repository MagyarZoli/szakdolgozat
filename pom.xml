<?xml version="1.0" encoding="UTF-8"?>
<!--
  Szülő POM: a közös Java-verzió, függőségverziók és pluginbeállítások helye.
  Minden modul innen örökli a beállításait, így egy verziót csak itt kell átírni.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>hu.thesis</groupId>
    <artifactId>callgraph-graphlets</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Call graph graphlets</name>
    <description>Java hívási gráfok egységes előállítása és graflet-alapú vizsgálata</description>

    <modules>
        <module>cg-core</module>
        <module>cg-builder-soot</module>
        <module>cg-builder-osa</module>
        <module>test-programs</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Függőségek -->
        <soot.version>4.7.1</soot.version>
        <picocli.version>4.7.7</picocli.version>
        <slf4j.version>2.0.17</slf4j.version>
        <junit.version>5.11.4</junit.version>

        <!-- Pluginok -->
        <compiler.plugin.version>3.13.0</compiler.plugin.version>
        <surefire.plugin.version>3.5.2</surefire.plugin.version>
        <jar.plugin.version>3.4.2</jar.plugin.version>
        <shade.plugin.version>3.6.0</shade.plugin.version>
        <javadoc.plugin.version>3.11.2</javadoc.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>hu.thesis</groupId>
                <artifactId>cg-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>hu.thesis</groupId>
                <artifactId>cg-builder-soot</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>hu.thesis</groupId>
                <artifactId>cg-builder-osa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.soot-oss</groupId>
                <artifactId>soot</artifactId>
                <version>${soot.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- A JUnit minden modulban elérhető tesztekhez -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <compilerArgs>
                            <arg>-Xlint:all,-processing</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${jar.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${shade.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- HTML-dokumentáció: mvn javadoc:aggregate → target/reports/apidocs/index.html
                 A privát tagok is bekerülnek, mert a dokumentáció elsősorban a saját munkához kell. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${javadoc.plugin.version}</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <docencoding>UTF-8</docencoding>
                    <charset>UTF-8</charset>
                    <show>private</show>
                    <doclint>all</doclint>
                    <doctitle>Hívási gráfok graflet-alapú vizsgálata – API</doctitle>
                    <windowtitle>callgraph-graphlets</windowtitle>
                    <excludePackageNames>hu.thesis.sample*</excludePackageNames>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
